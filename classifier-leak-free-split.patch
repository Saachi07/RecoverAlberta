+def test_build_report_has_everything_the_evaluate_script_prints():
+    probs = np.array([[0.8, 0.1, 0.1], [0.2, 0.7, 0.1], [0.1, 0.1, 0.8]])
+    rep = metrics.build_report([0, 1, 2], [0, 1, 2], probs, ["a", "b", "c"])
+    assert rep["accuracy"] == 1.0
