diff --git a/backend/app/services/item_fields.py b/backend/app/services/item_fields.py
new file mode 100644
index 0000000..06e80be
--- /dev/null
+++ b/backend/app/services/item_fields.py
@@ -0,0 +1,202 @@
+"""Validation for the inventory evidence fields added in migration 0012.
+
+Pure functions, no Flask or Supabase, so the rules are unit-testable. The items
+blueprint calls `clean_item_row` on every create and update: it keeps only
+writable keys and rejects malformed evidence fields with a message the client
+can show, instead of letting a bad value reach a database constraint.
+
+None is always accepted for the new fields (it clears them on PATCH).
+"""
+
+from __future__ import annotations
+
+import datetime as _dt
+from typing import Any, Optional
+
+from .taxonomy import CLAIM_CLASSES, get_leaf
+
+PRICE_BASES = ("replacement", "acv")
+
+# inventory.md s7. Multi-label; "none" stands alone.
+DAMAGE_TYPES = (
+    "smoke", "soot", "char", "heat_warping", "water_stain", "standing_water",
+    "flood_mud", "mold", "impact_dent", "wind_debris", "freeze_burst", "none",
+)
+
+BASE_FIELDS = frozenset({
+    "name", "category", "material", "estimated_value", "damage_type",
+    "damage_severity", "confidence", "image_url", "before_url", "after_url",
+    "receipts", "description", "room", "purchase_date", "case_id",
+})
+
+EXTRA_FIELDS = frozenset({
+    "price_low", "price_high", "price_basis", "price_date", "comparables",
+    "field_confidence", "taxonomy_id", "claim_class", "bulk", "damage_types",
+    "evidence", "source",
+})
+
+WRITABLE = BASE_FIELDS | EXTRA_FIELDS
+
+_MAX_PRICE = 10_000_000
+_MAX_COMPARABLES = 10
+_COMPARABLE_KEYS = ("name", "source", "price", "currency", "date", "url")
+_EVIDENCE_KEYS = ("photo_url", "photo_index", "bounding_box")
+_BOX_KEYS = ("x1", "y1", "x2", "y2")
+
+
+def _is_num(v: Any) -> bool:
+    return isinstance(v, (int, float)) and not isinstance(v, bool)
+
+
+def _is_iso_date(v: Any) -> bool:
+    if not isinstance(v, str):
+        return False
+    try:
+        _dt.date.fromisoformat(v)
+        return True
+    except ValueError:
+        return False
+
+
+def _price(field: str, v: Any) -> Optional[str]:
+    if not _is_num(v) or v < 0 or v > _MAX_PRICE:
+        return f"{field} must be a number between 0 and {_MAX_PRICE}"
+    return None
+
+
+def _comparables(v: Any) -> tuple[Any, Optional[str]]:
+    if not isinstance(v, list):
+        return None, "comparables must be a list"
+    if len(v) > _MAX_COMPARABLES:
+        return None, f"comparables can hold at most {_MAX_COMPARABLES} entries"
+    cleaned = []
+    for c in v:
+        if not isinstance(c, dict):
+            return None, "each comparable must be an object"
+        name = c.get("name")
+        if not isinstance(name, str) or not name.strip() or len(name) > 200:
+            return None, "each comparable needs a name (200 characters or fewer)"
+        out: dict[str, Any] = {"name": name.strip()}
+        if "price" in c and c["price"] is not None:
+            err = _price("comparable price", c["price"])
+            if err:
+                return None, err
+            out["price"] = c["price"]
+        for key, limit in (("source", 100), ("currency", 3), ("url", 500)):
+            val = c.get(key)
+            if val is None:
+                continue
+            if not isinstance(val, str) or len(val) > limit:
+                return None, f"comparable {key} must be text of {limit} characters or fewer"
+            if key == "url" and not val.startswith(("http://", "https://")):
+                return None, "comparable url must start with http:// or https://"
+            out[key] = val
+        if c.get("date") is not None:
+            if not _is_iso_date(c["date"]):
+                return None, "comparable date must be YYYY-MM-DD"
+            out["date"] = c["date"]
+        cleaned.append(out)
+    return cleaned, None
+
+
+def _field_confidence(v: Any) -> Optional[str]:
+    if not isinstance(v, dict) or len(v) > 16:
+        return "field_confidence must be an object with at most 16 fields"
+    for k, val in v.items():
+        if not isinstance(k, str) or not k or len(k) > 32:
+            return "field_confidence keys must be short text"
+        if not _is_num(val) or not 0 <= val <= 1:
+            return f"field_confidence[{k!r}] must be a number between 0 and 1"
+    return None
+
+
+def _evidence(v: Any) -> tuple[Any, Optional[str]]:
+    if not isinstance(v, dict):
+        return None, "evidence must be an object"
+    out: dict[str, Any] = {}
+    for key in _EVIDENCE_KEYS:
+        if key not in v or v[key] is None:
+            continue
+        val = v[key]
+        if key == "photo_url":
+            if not isinstance(val, str) or len(val) > 1000:
+                return None, "evidence.photo_url must be text of 1000 characters or fewer"
+        elif key == "photo_index":
+            if not isinstance(val, int) or isinstance(val, bool) or not 0 <= val < 1000:
+                return None, "evidence.photo_index must be a whole number"
+        elif key == "bounding_box":
+            if not isinstance(val, dict) or set(val) != set(_BOX_KEYS):
+                return None, "evidence.bounding_box needs x1, y1, x2, y2"
+            if not all(_is_num(val[k]) and 0 <= val[k] <= 1 for k in _BOX_KEYS):
+                return None, "evidence.bounding_box values must be between 0 and 1"
+            if val["x1"] >= val["x2"] or val["y1"] >= val["y2"]:
+                return None, "evidence.bounding_box must have x1 < x2 and y1 < y2"
+        out[key] = val
+    return out, None
+
+
+def clean_item_row(data: dict) -> tuple[dict, Optional[str]]:
+    """Keep writable keys and validate the evidence fields.
+
+    Returns (row, None) on success or ({}, message) on the first problem.
+    """
+    row = {k: v for k, v in data.items() if k in WRITABLE}
+
+    for f in ("price_low", "price_high"):
+        if row.get(f) is not None:
+            err = _price(f, row[f])
+            if err:
+                return {}, err
+    low, high = row.get("price_low"), row.get("price_high")
+    if low is not None and high is not None and low > high:
+        return {}, "price_low cannot be greater than price_high"
+
+    if row.get("price_basis") is not None and row["price_basis"] not in PRICE_BASES:
+        return {}, "price_basis must be 'replacement' or 'acv'"
+
+    if row.get("price_date") is not None and not _is_iso_date(row["price_date"]):
+        return {}, "price_date must be YYYY-MM-DD"
+
+    if row.get("claim_class") is not None and row["claim_class"] not in CLAIM_CLASSES:
+        return {}, "claim_class must be contents, building, or unclear"
+
+    if "bulk" in row and row["bulk"] is not None and not isinstance(row["bulk"], bool):
+        return {}, "bulk must be true or false"
+    if "bulk" in row and row["bulk"] is None:
+        del row["bulk"]  # column is NOT NULL; null means "leave it alone"
+
+    tid = row.get("taxonomy_id")
+    if tid is not None and (not isinstance(tid, str) or get_leaf(tid) is None):
+        return {}, "taxonomy_id is not a known taxonomy class"
+
+    dt = row.get("damage_types")
+    if dt is not None:
+        if not isinstance(dt, list) or len(dt) > len(DAMAGE_TYPES):
+            return {}, "damage_types must be a list"
+        bad = [d for d in dt if d not in DAMAGE_TYPES]
+        if bad:
+            return {}, f"unknown damage type: {bad[0]!r}"
+        if "none" in dt and len(dt) > 1:
+            return {}, "damage_types 'none' cannot be combined with other types"
+        row["damage_types"] = sorted(set(dt))
+
+    if row.get("comparables") is not None:
+        row["comparables"], err = _comparables(row["comparables"])
+        if err:
+            return {}, err
+
+    if row.get("field_confidence") is not None:
+        err = _field_confidence(row["field_confidence"])
+        if err:
+            return {}, err
+
+    if row.get("evidence") is not None:
+        row["evidence"], err = _evidence(row["evidence"])
+        if err:
+            return {}, err
+
+    src = row.get("source")
+    if src is not None and (not isinstance(src, str) or not src.strip() or len(src) > 100):
+        return {}, "source must be text of 100 characters or fewer"
+
+    return row, None
diff --git a/backend/supabase/migrations/0012_inventory_extras.sql b/backend/supabase/migrations/0012_inventory_extras.sql
new file mode 100644
index 0000000..403fb61
--- /dev/null
+++ b/backend/supabase/migrations/0012_inventory_extras.sql
@@ -0,0 +1,65 @@
+-- Inventory evidence columns (inventory.md s2, s3).
+--
+-- case_items held one number (estimated_value) and no record of where it came
+-- from. The photo inventory redesign needs a home for:
+--   - a price range with its basis (replacement cost vs actual cash value),
+--     date, and the comparable products behind it
+--   - per-field confidence, so low-confidence fields can be flagged for review
+--   - the taxonomy class, contents/building claim class, and bulk flag
+--   - the damage vocabulary (multi-label) and where in which photo the item
+--     was seen
+--   - which component produced the row (model and version, rule id, or user)
+--
+-- estimated_value stays as the single headline number (the "mid" value, and
+-- the replacement cost when price_basis is 'replacement'), so the existing
+-- recommender, exports, and Inventory page keep working unchanged. Every new
+-- column is nullable or defaulted; old rows and old clients are unaffected.
+--
+-- Row-level security is table-wide, so these columns inherit it.
+
+alter table public.case_items
+    add column if not exists price_low      numeric(12, 2),
+    add column if not exists price_high     numeric(12, 2),
+    add column if not exists price_basis    text,
+    add column if not exists price_date     date,
+    add column if not exists comparables    jsonb,
+    add column if not exists field_confidence jsonb,
+    add column if not exists taxonomy_id    text,
+    add column if not exists claim_class    text,
+    add column if not exists bulk           boolean not null default false,
+    add column if not exists damage_types   text[],
+    add column if not exists evidence       jsonb,
+    add column if not exists source         text;
+
+-- Constraints are dropped first so this file can be re-run.
+alter table public.case_items drop constraint if exists case_items_price_range_ck;
+alter table public.case_items add constraint case_items_price_range_ck
+    check (
+        (price_low is null or price_low >= 0)
+        and (price_high is null or price_high >= 0)
+        and (price_low is null or price_high is null or price_low <= price_high)
+    );
+
+alter table public.case_items drop constraint if exists case_items_price_basis_ck;
+alter table public.case_items add constraint case_items_price_basis_ck
+    check (price_basis is null or price_basis in ('replacement', 'acv'));
+
+alter table public.case_items drop constraint if exists case_items_claim_class_ck;
+alter table public.case_items add constraint case_items_claim_class_ck
+    check (claim_class is null or claim_class in ('contents', 'building', 'unclear'));
+
+alter table public.case_items drop constraint if exists case_items_comparables_ck;
+alter table public.case_items add constraint case_items_comparables_ck
+    check (comparables is null or jsonb_typeof(comparables) = 'array');
+
+alter table public.case_items drop constraint if exists case_items_field_confidence_ck;
+alter table public.case_items add constraint case_items_field_confidence_ck
+    check (field_confidence is null or jsonb_typeof(field_confidence) = 'object');
+
+alter table public.case_items drop constraint if exists case_items_evidence_ck;
+alter table public.case_items add constraint case_items_evidence_ck
+    check (evidence is null or jsonb_typeof(evidence) = 'object');
+
+-- Lookups the app is likely to need: totals by claim class, bulk-entry flags.
+create index if not exists case_items_claim_class_idx
+    on public.case_items(user_id, claim_class);
diff --git a/tests/test_item_fields.py b/tests/test_item_fields.py
new file mode 100644
index 0000000..3509531
--- /dev/null
+++ b/tests/test_item_fields.py
@@ -0,0 +1,178 @@
+"""Tests for validation of the inventory evidence fields (migration 0012)."""
+
+import sys
+from pathlib import Path
+
+import pytest
+
+BACKEND = Path(__file__).resolve().parent.parent / "backend"
+if str(BACKEND) not in sys.path:
+    sys.path.insert(0, str(BACKEND))
+
+pytest.importorskip("pydantic")
+
+from app.services.item_fields import (  # noqa: E402
+    BASE_FIELDS,
+    DAMAGE_TYPES,
+    EXTRA_FIELDS,
+    WRITABLE,
+    clean_item_row,
+)
+
+MIGRATION = BACKEND / "supabase" / "migrations" / "0012_inventory_extras.sql"
+
+
+def ok(data):
+    row, problem = clean_item_row(data)
+    assert problem is None, problem
+    return row
+
+
+def bad(data, fragment):
+    row, problem = clean_item_row(data)
+    assert row == {}
+    assert problem and fragment in problem
+
+
+class TestPassthrough:
+    def test_unknown_keys_dropped(self):
+        row = ok({"name": "sofa", "user_id": "x", "id": "y", "evil": 1})
+        assert row == {"name": "sofa"}
+
+    def test_old_payload_unchanged(self):
+        payload = {"name": "sofa", "category": "furniture", "estimated_value": 450,
+                   "confidence": 0.8, "room": "living_room"}
+        assert ok(payload) == payload
+
+    def test_writable_is_union(self):
+        assert WRITABLE == BASE_FIELDS | EXTRA_FIELDS
+        assert not BASE_FIELDS & EXTRA_FIELDS
+
+
+class TestPrice:
+    def test_range_ok(self):
+        row = ok({"name": "tv", "price_low": 300, "price_high": 500.5,
+                  "price_basis": "acv", "price_date": "2026-10-21"})
+        assert row["price_low"] == 300
+
+    @pytest.mark.parametrize("field", ["price_low", "price_high"])
+    @pytest.mark.parametrize("value", [-1, "12", True, 10**9])
+    def test_bad_price(self, field, value):
+        bad({"name": "x", field: value}, field)
+
+    def test_low_above_high(self):
+        bad({"name": "x", "price_low": 9, "price_high": 3}, "cannot be greater")
+
+    def test_single_bound_allowed(self):
+        ok({"name": "x", "price_high": 3})
+
+    def test_basis_and_date(self):
+        bad({"name": "x", "price_basis": "market"}, "price_basis")
+        bad({"name": "x", "price_date": "21/10/2026"}, "price_date")
+
+    def test_none_clears(self):
+        row = ok({"name": "x", "price_low": None, "price_basis": None})
+        assert row["price_low"] is None
+
+
+class TestClassFields:
+    def test_claim_class(self):
+        ok({"name": "x", "claim_class": "building"})
+        bad({"name": "x", "claim_class": "maybe"}, "claim_class")
+
+    def test_taxonomy_id_must_exist(self):
+        ok({"name": "x", "taxonomy_id": "sofa"})
+        bad({"name": "x", "taxonomy_id": "flying_carpet"}, "taxonomy_id")
+        bad({"name": "x", "taxonomy_id": 5}, "taxonomy_id")
+
+    def test_bulk(self):
+        assert ok({"name": "x", "bulk": True})["bulk"] is True
+        bad({"name": "x", "bulk": "yes"}, "bulk")
+
+    def test_bulk_null_is_ignored_not_cleared(self):
+        assert "bulk" not in ok({"name": "x", "bulk": None})
+
+    def test_damage_types_sorted_and_deduped(self):
+        row = ok({"name": "x", "damage_types": ["soot", "smoke", "soot"]})
+        assert row["damage_types"] == ["smoke", "soot"]
+
+    def test_damage_types_rules(self):
+        bad({"name": "x", "damage_types": ["lava"]}, "unknown damage type")
+        bad({"name": "x", "damage_types": ["none", "smoke"]}, "none")
+        bad({"name": "x", "damage_types": "smoke"}, "list")
+        assert "none" in DAMAGE_TYPES
+
+
+class TestComparables:
+    GOOD = {"name": "IKEA Kivik sofa", "source": "ikea.ca", "price": 899,
+            "currency": "CAD", "date": "2026-10-01", "url": "https://example.com/p"}
+
+    def test_good(self):
+        assert ok({"name": "x", "comparables": [self.GOOD]})["comparables"] == [self.GOOD]
+
+    def test_unknown_keys_dropped(self):
+        row = ok({"name": "x", "comparables": [{**self.GOOD, "secret": 1}]})
+        assert "secret" not in row["comparables"][0]
+
